# Credenciales de las bases de datos.
# Copiar este archivo a .env y ajustar los valores. El .env NO se versiona.

POSTGRES_USER=banco
POSTGRES_PASSWORD=banco
POSTGRES_DB_CLIENTES=clientes_db
POSTGRES_DB_CUENTAS=cuentas_db

# Puertos publicados en el host (el contenedor siempre usa 5432)
POSTGRES_CLIENTES_PORT=5433
POSTGRES_CUENTAS_PORT=5434

# Puertos de los microservicios
CLIENTES_PORT=8081
CUENTAS_PORT=8082

# URL interna de msa-cuentas vista desde msa-clientes
CUENTAS_BASE_URL=http://msa-cuentas:8082
