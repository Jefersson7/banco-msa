# Credenciales de las bases de datos (comunes en desarrollo)
DB_USER=banco
DB_PASSWORD=banco

# Base de datos de msa-clientes
# HOST: "localhost" al ejecutar la app en el host, "postgres-clientes" dentro de Docker
# PORT: puerto publicado en el host (5433). Dentro de Docker se usa el puerto interno (5432)
DB_CLIENTES_HOST=localhost
DB_CLIENTES_PORT=5433
DB_CLIENTES_NAME=clientes_db

# Base de datos de msa-cuentas
DB_CUENTAS_HOST=localhost
DB_CUENTAS_PORT=5434
DB_CUENTAS_NAME=cuentas_db

# URL de msa-cuentas vista desde msa-clientes
# En Docker se sobrescribe a http://msa-cuentas:8082
CUENTAS_BASE_URL=http://localhost:8082

# URL de msa-clientes vista desde msa-cuentas
# En Docker se sobrescribe a http://msa-clientes:8081
CLIENTES_BASE_URL=http://localhost:8081
