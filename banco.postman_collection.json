											"var body = pm.response.json();",
											"pm.test('title Saldo insuficiente', function () { pm.expect(body.title).to.eql('Saldo insuficiente'); });",
											"pm.test('detail Saldo no disponible', function () { pm.expect(body.detail).to.eql('Saldo no disponible'); });",
