						{
							"name": "Movimiento sin saldo (egreso)",
							"description": "Un egreso que dejaria el saldo por debajo de cero devuelve 422 SALDO_NO_DISPONIBLE con el detalle \"Saldo no disponible\" y no altera el saldo.",
							"request": {
								"method": "POST",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"cuenta\": \"{{cuentaSinSaldo}}\",\n  \"tipoMovimiento\": \"EGRESO\",\n  \"valor\": -150.00,\n  \"referencia\": \"SIN-SALDO-001\"\n}",
									"options": { "raw": { "language": "json" } }
								},
								"url": {
									"raw": "{{base_cuentas}}/movimientos",
