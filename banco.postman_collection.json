					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('201 Created', function () { pm.response.to.have.status(201); });",
									"var body = pm.response.json();",
									"pm.collectionVariables.set('movimientoId', body.id);",
									"pm.collectionVariables.set('movimientoFecha', body.fecha);",
									"pm.collectionVariables.set('movimientoValor', body.valor);",
									"pm.test('el tipo concuerda con el signo del valor', function () { pm.expect(body.tipoMovimiento).to.eql('INGRESO'); });",
									"pm.test('el saldo resultante es el anterior mas el valor', function () {",
									"    var saldoAntes = Number(pm.collectionVariables.get('saldoCuentaAntes'));",
									"    pm.expect(body.saldo).to.eql(saldoAntes + 100.00);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Crear movimiento (egreso)",
					"description": "El tipo EGRESO debe concordar con un valor negativo.",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cuenta\": \"{{numeroCuenta}}\",\n  \"tipoMovimiento\": \"EGRESO\",\n  \"valor\": -50.00,\n  \"referencia\": \"RETIRO-001\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_cuentas}}/movimientos",
							"host": ["{{base_cuentas}}"],
							"path": ["movimientos"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('201 Created', function () { pm.response.to.have.status(201); });",
									"var body = pm.response.json();",
									"pm.test('el valor conserva el signo', function () { pm.expect(body.valor).to.be.below(0); });",
									"pm.test('el tipo concuerda con el signo del valor', function () { pm.expect(body.tipoMovimiento).to.eql('EGRESO'); });",
									"pm.test('el saldo resultante es el anterior menos 50.00', function () {",
									"    var saldoAntes = Number(pm.collectionVariables.get('saldoCuentaAntes'));",
									"    pm.expect(body.saldo).to.eql(saldoAntes + 100.00 - 50.00);",
									"});"
								]
							}
						}
					]
				},
