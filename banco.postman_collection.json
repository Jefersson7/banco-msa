							"name": "Verificar saldo sin cambios",
							"request": {
								"method": "GET",
								"url": {
									"raw": "{{base_cuentas}}/cuentas/{{cuentaSinSaldo}}",
									"host": ["{{base_cuentas}}"],
									"path": ["cuentas", "{{cuentaSinSaldo}}"]
								}
							},
							"event": [
								{
									"listen": "test",
									"script": {
										"type": "text/javascript",
										"exec": [
											"pm.test('200 OK', function () { pm.response.to.have.status(200); });",
											"pm.test('el saldo no cambio', function () { pm.expect(pm.response.json().saldoActual).to.eql(100.00); });"
										]
									}
								}
							]
						}
					]
				},
				{
					"name": "Desactivar cuentas del cliente (masivo)",
					"description": "Actualiza en bloque el estado de las cuentas activas del cliente. Va al final porque las desactiva todas.",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"estado\": \"INACTIVA\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_cuentas}}/cuentas?clienteId={{clientId}}",
							"host": ["{{base_cuentas}}"],
							"path": ["cuentas"],
							"query": [{ "key": "clienteId", "value": "{{clientId}}" }]
						}
					}
				}
			]
		},
		{
			"name": "msa-clientes (cierre)",
			"item": [
				{
					"name": "Dar de baja cliente",
					"description": "Baja logica: el cliente pasa a INACTIVO. De forma asincrona, msa-cuentas desactiva las cuentas activas del cliente. Va al final del run para no inactivar al cliente antes de crear sus cuentas.",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{base_clientes}}/clientes/{{clientId}}",
							"host": ["{{base_clientes}}"],
							"path": ["clientes", "{{clientId}}"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('204 No Content', function () { pm.response.to.have.status(204); });"
								]
							}
						}
					]
				}
			]
		}
	]
}
