					}
				},
				{
					"name": "Actualizar cuenta",
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tipoCuenta\": \"CORRIENTE\",\n  \"estado\": \"INACTIVA\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_cuentas}}/cuentas/{{numeroCuenta}}",
							"host": ["{{base_cuentas}}"],
							"path": ["cuentas", "{{numeroCuenta}}"]
						}
					}
				},
				{
					"name": "Actualizar cuenta parcialmente (PATCH)",
					"description": "Actualiza solo los campos que llegan en el cuerpo: tipo de cuenta y/o estado. El saldo no se toca por este endpoint.",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"estado\": \"INACTIVA\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_cuentas}}/cuentas/{{numeroCuenta}}",
							"host": ["{{base_cuentas}}"],
							"path": ["cuentas", "{{numeroCuenta}}"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', function () { pm.response.to.have.status(200); });"
								]
							}
						}
					]
				},
				{
					"name": "Actualizar cuentas de un cliente",
					"description": "Actualiza en bloque el estado de las cuentas activas de un cliente (PATCH sobre la coleccion filtrada). msa-clientes lo llama de forma asincrona cuando el cliente se da de baja.",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"estado\": \"INACTIVA\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_cuentas}}/cuentas?clienteId={{clientId}}",
							"host": ["{{base_cuentas}}"],
							"path": ["cuentas"],
							"query": [{ "key": "clienteId", "value": "{{clientId}}" }]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', function () { pm.response.to.have.status(200); });"
								]
							}
						}
					]
				},
				{
					"name": "Crear movimiento",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cuenta\": \"{{numeroCuenta}}\",\n  \"tipoMovimiento\": \"INGRESO\",\n  \"valor\": 100.00,\n  \"referencia\": \"TRANSFERENCIA-001\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_cuentas}}/movimientos",
							"host": ["{{base_cuentas}}"],
							"path": ["movimientos"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('201 Created', function () { pm.response.to.have.status(201); });",
									"var body = pm.response.json();",
									"pm.collectionVariables.set('movimientoId', body.id);",
									"pm.test('el tipo concuerda con el signo del valor', function () { pm.expect(body.tipoMovimiento).to.eql('INGRESO'); });",
									"pm.test('el saldo resultante queda en 600.00', function () { pm.expect(body.saldo).to.eql(600.00); });"
								]
							}
						}
					]
				},
				{
					"name": "Crear movimiento (egreso)",
					"description": "El tipo EGRESO debe concordar con un valor negativo.",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cuenta\": \"{{numeroCuenta}}\",\n  \"tipoMovimiento\": \"EGRESO\",\n  \"valor\": -50.00,\n  \"referencia\": \"RETIRO-001\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_cuentas}}/movimientos",
							"host": ["{{base_cuentas}}"],
							"path": ["movimientos"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('201 Created', function () { pm.response.to.have.status(201); });",
									"var body = pm.response.json();",
									"pm.test('el valor conserva el signo', function () { pm.expect(body.valor).to.be.below(0); });",
									"pm.test('el tipo concuerda con el signo del valor', function () { pm.expect(body.tipoMovimiento).to.eql('EGRESO'); });",
									"pm.test('el saldo resultante queda en 550.00', function () { pm.expect(body.saldo).to.eql(550.00); });"
								]
							}
						}
					]
				},
				{
					"name": "Movimiento invalido (tipo y signo)",
					"description": "Un INGRESO exige valor positivo: un valor negativo devuelve 400 TIPO_MOVIMIENTO_INVALIDO y no altera el saldo.",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cuenta\": \"{{numeroCuenta}}\",\n  \"tipoMovimiento\": \"INGRESO\",\n  \"valor\": -10.00,\n  \"referencia\": \"INVALIDA-001\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_cuentas}}/movimientos",
							"host": ["{{base_cuentas}}"],
							"path": ["movimientos"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });",
									"pm.test('codigo TIPO_MOVIMIENTO_INVALIDO', function () { pm.expect(pm.response.json().code).to.eql('TIPO_MOVIMIENTO_INVALIDO'); });"
								]
							}
						}
					]
				},
				{
					"name": "Listar movimientos",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_cuentas}}/movimientos?cuenta={{numeroCuenta}}",
							"host": ["{{base_cuentas}}"],
							"path": ["movimientos"],
							"query": [{ "key": "cuenta", "value": "{{numeroCuenta}}" }]
						}
					}
				},
				{
