						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Ana Perez\",\n  \"genero\": \"FEMENINO\",\n  \"edad\": 30,\n  \"identificacion\": \"1020304050\",\n  \"direccion\": \"Calle 45 #12-30\",\n  \"telefono\": \"3105550001\",\n  \"password\": \"secreta123\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_clientes}}/clientes",
							"host": ["{{base_clientes}}"],
							"path": ["clientes"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('201 Created', function () { pm.response.to.have.status(201); });",
									"var body = pm.response.json();",
									"pm.test('devuelve clientId', function () {",
									"    pm.expect(body.clientId).to.be.a('string');",
									"    pm.collectionVariables.set('clientId', body.clientId);",
									"});",
									"pm.test('no devuelve la contrasena', function () {",
									"    pm.expect(pm.response.text()).to.not.include('secreta123');",
									"});",
									"pm.test('devuelve genero y edad', function () {",
									"    pm.expect(body.genero).to.eql('FEMENINO');",
									"    pm.expect(body.edad).to.eql(30);",
									"});"
								]
							}
						}
					]
				},
