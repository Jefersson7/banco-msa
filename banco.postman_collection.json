						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cuenta\": \"{{numeroCuenta}}\",\n  \"tipoMovimiento\": \"INGRESO\",\n  \"valor\": 100.00,\n  \"fecha\": \"2026-10-23T10:00:00\",\n  \"referencia\": \"TRANSFERENCIA-001\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_cuentas}}/movimientos",
							"host": ["{{base_cuentas}}"],
