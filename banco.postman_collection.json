					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_cuentas}}/movimientos/{{movimientoId}}",
							"host": ["{{base_cuentas}}"],
							"path": ["movimientos", "{{movimientoId}}"]
						}
					}
				},
				{
					"name": "Actualizar movimiento",
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"referencia\": \"TRANSFERENCIA-001-CORREGIDA\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_cuentas}}/movimientos/{{movimientoId}}",
							"host": ["{{base_cuentas}}"],
							"path": ["movimientos", "{{movimientoId}}"]
						}
					}
				},
				{
					"name": "Crear cuenta para prueba de inactiva",
					"description": "Cuenta propia de esta prueba: no altera la cuenta usada por el resto de la coleccion.",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tipoCuenta\": \"AHORRO\",\n  \"saldoInicial\": 50.00,\n  \"clienteId\": \"{{clientId}}\",\n  \"nombreCliente\": \"Ana Perez\",\n  \"identificacion\": \"1020304050\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_cuentas}}/cuentas",
							"host": ["{{base_cuentas}}"],
							"path": ["cuentas"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('201 Created', function () { pm.response.to.have.status(201); });",
									"pm.collectionVariables.set('cuentaInactiva', pm.response.json().numeroCuenta);"
								]
							}
						}
					]
				},
				{
					"name": "Desactivar cuenta",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"estado\": \"INACTIVA\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_cuentas}}/cuentas/{{cuentaInactiva}}",
							"host": ["{{base_cuentas}}"],
							"path": ["cuentas", "{{cuentaInactiva}}"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', function () { pm.response.to.have.status(200); });",
									"pm.test('cuenta INACTIVA', function () { pm.expect(pm.response.json().estado).to.eql('INACTIVA'); });"
								]
							}
						}
					]
				},
				{
					"name": "Movimiento en cuenta inactiva",
					"description": "Solo las cuentas ACTIVA admiten movimientos: devuelve 409 CUENTA_NO_ACTIVA y no altera el saldo.",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cuenta\": \"{{cuentaInactiva}}\",\n  \"tipoMovimiento\": \"INGRESO\",\n  \"valor\": 10.00,\n  \"referencia\": \"INACTIVA-001\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_cuentas}}/movimientos",
							"host": ["{{base_cuentas}}"],
							"path": ["movimientos"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('409 Conflict', function () { pm.response.to.have.status(409); });",
									"pm.test('codigo CUENTA_NO_ACTIVA', function () { pm.expect(pm.response.json().code).to.eql('CUENTA_NO_ACTIVA'); });"
								]
							}
						}
					]
				},
				{
					"name": "Verificar saldo intacto",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_cuentas}}/cuentas/{{cuentaInactiva}}",
							"host": ["{{base_cuentas}}"],
							"path": ["cuentas", "{{cuentaInactiva}}"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', function () { pm.response.to.have.status(200); });",
									"pm.test('el saldo no cambio', function () { pm.expect(pm.response.json().saldoActual).to.eql(50.00); });"
								]
							}
						}
					]
				}
			]
		}
	]
}
